# ── Server ──────────────────────────────────────────────────────────
PORT=3001

# ── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=                  # anon/publishable key
SUPABASE_SERVICE_KEY=          # service role key (for cron, bypasses RLS)

# ── AI Providers (at least one required) ────────────────────────────
NVIDIA_API_KEY=                # Primary: meta/llama-3.1-70b via NVIDIA API
GROQ_API_KEY=                  # Fallback: llama-3.3-70b via Groq

# ── Job Scraping (optional — Data Lake feeds) ──────────────────────
# Apify API keys are stored in the `apify_fleet_configs` Supabase table.
# No env var needed for Apify.

# ── Browser Agent (Stagehand) ──────────────────────────────────────
HEADLESS=false

# ── CORS (comma-separated origins, optional) ───────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
